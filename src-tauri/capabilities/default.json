{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for BellaNote",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "dialog:default",
    "opener:default",
    "allow-get-library",
    "allow-create-organization",
    "allow-rename-organization",
    "allow-delete-organization",
    "allow-create-topic",
    "allow-rename-topic",
    "allow-delete-topic",
    "allow-create-meeting-group",
    "allow-rename-meeting-group",
    "allow-delete-meeting-group",
    "allow-list-artifacts",
    "allow-get-artifact",
    "allow-import-audio",
    "allow-import-transcript",
    "allow-rename-artifact",
    "allow-delete-artifact",
    "allow-retry-artifact",
    "allow-get-artifact-audio-path",
    "allow-set-openai-api-key",
    "allow-clear-openai-api-key",
    "allow-openai-api-key-configured",
    "allow-chat-scope-preview",
    "allow-get-chat-thread",
