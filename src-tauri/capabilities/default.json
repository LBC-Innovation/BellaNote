{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for BellaNote",
  "windows": ["main", "video-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-webview-close",
    "dialog:default",
    "opener:default",
    "allow-get-library",
    "allow-create-organization",
    "allow-rename-organization",
    "allow-delete-organization",
    "allow-create-topic",
    "allow-rename-topic",
    "allow-delete-topic",
